# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Rendered output. Renders live in catalog/<type>/<release>/renders/, but the
# video itself never enters git — Google Drive is the archive. The stills the
# same folder holds (-thumb.png, -lyrics.png) are tracked.
output/
*.mp4
*.mkv
*.mov
*.webm

# Working audio, except the catalog sources: those are committed on purpose,
# since git is the only copy that survives an ephemeral cloud session.
*.wav
*.mp3
*.m4a
*.flac
!catalog/*/*/assets/music/*

# Editors / OS
.DS_Store
.idea/
.vscode/

# ffmpeg two-pass logs and split transfer parts
ffmpeg2pass-*
*.mp4.part*
